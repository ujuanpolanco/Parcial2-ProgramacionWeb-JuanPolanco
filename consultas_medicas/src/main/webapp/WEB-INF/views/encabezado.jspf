<%@ page pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>
<%-- Barra de navegación: muestra las opciones según el rol del usuario en sesión --%>
<nav class="navbar navbar-expand navbar-dark bg-primary mb-4">
	<div class="container">
		<a class="navbar-brand" href="${pageContext.request.contextPath}/">Consultas Médicas</a>
		<ul class="navbar-nav me-auto">
			<c:if test="${sessionScope.usuario.rol == 'ADMINISTRADOR'}">
				<li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/admin/consultas">Consultorios</a></li>
				<li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/admin/medicos">Médicos</a></li>
			</c:if>
			<c:if test="${sessionScope.usuario.rol == 'MEDICO'}">
				<li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/medico/consultas">Mis consultas</a></li>
			</c:if>
			<c:if test="${sessionScope.usuario.rol == 'PACIENTE'}">
				<li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/paciente/citas">Mis citas</a></li>
			</c:if>
			<li class="nav-item"><a class="nav-link" href="${pageContext.request.contextPath}/swagger-ui.html" target="_blank">API (Swagger)</a></li>
		</ul>
		<c:if test="${not empty sessionScope.usuario}">
			<span class="navbar-text text-white me-3">
				<c:out value="${sessionScope.usuario.nombre}" /> (<c:out value="${sessionScope.usuario.rol}" />)
			</span>
			<a class="btn btn-outline-light btn-sm" href="${pageContext.request.contextPath}/logout">Cerrar sesión</a>
		</c:if>
	</div>
</nav>
